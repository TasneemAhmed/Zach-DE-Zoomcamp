      <column caption='Difficulty Level' datatype='string' name='[Calculation_1021191251221499905]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([difficulty]) THEN &quot;Unknown&quot;&#13;&#10;ELSEIF [difficulty] &lt;= 50 THEN &quot;Easy&quot;&#13;&#10;ELSEIF [difficulty] &lt;= 100 THEN &quot;Medium&quot;&#13;&#10;ELSEIF [difficulty] &lt;= 170 THEN &quot;Hard&quot;&#13;&#10;ELSE &quot;Very Hard&quot;&#13;&#10;END' />
