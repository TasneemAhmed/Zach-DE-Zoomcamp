      <column caption='Referrer Mapped' datatype='string' name='[Calculation_1685472196169961473]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if CONTAINS([referrer], &apos;linkedin&apos;) then &apos;Linkedin&apos;&#13;&#10;ELSEIF CONTAINS([referrer], &apos;lnkd.in&apos;) then &apos;Linkedin&apos;&#13;&#10;ELSEIF CONTAINS([referrer], &apos;google&apos;) then &apos;Google&apos;&#13;&#10;ELSEIF CONTAINS([referrer], &apos;instagram&apos;) then &apos;Instgram&apos;&#13;&#10;ELSEIF CONTAINS([referrer], &apos;t.co&apos;) then &apos;Twitter&apos;&#13;&#10;ELSEIF CONTAINS([referrer], &apos;ezachly&apos;) then &apos;On Site&apos;&#13;&#10;ELSEIF CONTAINS([referrer], &apos;zachwilson&apos;) then &apos;On Site&apos;&#13;&#10;ELSEIF CONTAINS([referrer], &apos;substack&apos;) then &apos;Substack&apos;&#13;&#10;else &apos;Others&apos;&#13;&#10;end' />
      </column>
      <column caption='Browser Mapped' datatype='string' name='[Calculation_1685472196190040066]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if CONTAINS(lower([browser_type]), &apos;bot&apos;) THEN &apos;Bot&apos;&#13;&#10;else [browser_type]&#13;&#10;end' />
      </column>
